# =========================================================
# FX Remittance AI - 환경 설정 예시
# 이 파일을 복사하여 .env로 저장한 뒤 값을 채워 사용한다.
#   cp .env.example .env
# =========================================================

# ---- 실행 모드 ----
# mock: 외부 서비스(Ollama 등) 없이 프로토타입 전체를 Mock으로 실행
# live: 실제 Ollama API를 호출
LLM_MODE=live
# mock: 신청서 이미지와 무관하게 고정된 Mock 구조화 데이터를 반환
# vision: Ollama Vision 모델(멀티모달 LLM)로 이미지에서 구조화 데이터를 바로 추출
#   - 실사용 시 권장하는 모드다(모델은 OLLAMA_VISION_MODEL 참고 - qwen2.5vl
#     권장, llava는 한글 밀집 서식에서 정확도가 낮아 비권장).
#   - 과거 PaddleOCR 모드가 있었으나 실제 서식 비교에서 속도/정확도 모두
#     vision에 크게 뒤처져 제거했다(섹션 41.18 참고).
OCR_MODE=vision
# mock: 사전 정의된 샘플 규정 텍스트로 RAG 파이프라인 시연
# pdf: data/regulations/ 의 실제 PDF를 인덱싱하여 사용
RAG_MODE=json

# ---- Ollama (LLM 분석 전용, LLM_MODE=live) ----
# 기본값은 Ollama Cloud + gpt-oss:120b-cloud다 - llama3.1(8B, 로컬)과 실측
# 비교한 결과 종합 지능/코딩/한국어 이해 전부 확실히 앞서서(섹션 41.21
# 참고) 기본 모델로 채택했다. Ollama Cloud 계정 + 아래 OLLAMA_API_KEY가
# 필요하다(https://ollama.com 에서 발급).
#
# 계정/키 없이 무료로 쓰고 싶으면 아래 세 줄을 이렇게 바꾸면 된다:
#   OLLAMA_BASE_URL=http://localhost:11434
#   OLLAMA_MODEL=llama3.1
#   OLLAMA_API_KEY=            (비워둠)
#   (로컬에 ollama pull llama3.1 필요)
OLLAMA_BASE_URL=https://ollama.com
# 거래 문맥 분석에 사용할 모델명 (Ollama Cloud면 -cloud 접미사 필요)
OLLAMA_MODEL=gpt-oss:120b-cloud
# Ollama 호출 타임아웃(초). Vision OCR 콜드 스타트(모델이 메모리에서 내려간
# 뒤 첫 호출)는 이미지 인코딩만으로 약 50초, 전체 70~90초까지 걸릴 수 있어
# (섹션 41.20) 60초 미만이면 실제로 타임아웃이 발생한다.
OLLAMA_TIMEOUT=120
# Ollama Cloud 등 인증이 필요한 엔드포인트용 API Key. 설정하면 LLM 분석
# 호출에 "Authorization: Bearer <key>" 헤더가 자동으로 붙는다. 로컬
# Ollama를 쓴다면 비워두면 된다.
OLLAMA_API_KEY=a5db71f4576b46679cecfa824f7d7a0e.C5w6TPlJNzgSCHFJFTOFD83S

# ---- Ollama Vision (OCR_MODE=vision 전용) ----
# 위 LLM용 Ollama와 별도의 엔드포인트를 쓸 수 있다(비워두면 위
# OLLAMA_BASE_URL/OLLAMA_API_KEY를 그대로 사용). Ollama Cloud는
# qwen2.5vl 같은 Vision 모델을 제공하지 않으므로, 위 LLM 기본값이
# Cloud로 바뀐 것과 무관하게 Vision은 항상 로컬 Ollama를 쓰도록 분리해
# 명시적으로 로컬을 지정해뒀다.
# qwen2.5vl을 권장한다 - 실제 한글 손글씨 서식으로 비교한 결과 llava는
# 이미지를 제대로 읽지 못하고 프롬프트의 설명 문구를 그대로 베끼는
# 문제가 있었다.
OLLAMA_VISION_MODEL=qwen2.5vl
OLLAMA_VISION_BASE_URL=http://localhost:11434
OLLAMA_VISION_API_KEY=

# ---- Ollama Embedding (사유코드/RAG 검색 전용) ----
# 사유코드/RAG 임베딩도 위 LLM용 Ollama와 다른 엔드포인트를 쓸 수 있다.
# Ollama Cloud는 임베딩 모델을 제공하지 않으므로, Vision과 마찬가지로
# 로컬을 명시적으로 지정해뒀다(bge-m3 등 다국어 모델 추천 - 한국어 검색
# 품질이 nomic-embed-text보다 좋음). 비워두면 위 OLLAMA_BASE_URL/
# OLLAMA_API_KEY를 그대로 사용한다.
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_EMBED_BASE_URL=http://localhost:11434
OLLAMA_EMBED_API_KEY=

# ---- Database ----
DATABASE_URL=sqlite:///./data/fx_remittance.db

# ---- Vector Store (RAG / 사유코드 검색) ----
CHROMA_PERSIST_DIR=./data/chroma
REGULATION_PDF_DIR=./data/regulations

# ---- Logging ----
LOG_LEVEL=INFO

# 국가법령정보 공동활용 API
LAW_API_KEY="amlanalyzer"
